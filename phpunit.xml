<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- ⚠ PHP CLI の既定 memory_limit は 128M で、2026-08-16 時点の実測ピークが 126.50 MB
             （上限の 99%）だった。この状態だと実行のたびに OOM したりしなかったりする
             （実測: 9 回中 4 回が Fatal error。落ちる場所は毎回フレームワーク側で、
             コンパイル済み Blade や PHPUnit のメタデータパーサだった）。
             テストが増えるほど確実に壊れるので明示的に引き上げる。
             ⚠ この行を消すと「特定のテストが悪い」ように見える不安定な失敗が戻る。
             2026-10-01: 512M でも足りなくなった（3204 本で 515.50 MB の Fatal error）ので 1G にした。当時の主な
             原因だった Carbon の翻訳の積み増しは Carbon 3.14 で直り、テスト側の片付けは 2026-10-03 に外した。
             今も 1 本ごとに増えるのは、OPcache の無い CLI がクロージャを含むファイルを起動のたびに読み直して
             残す分。2026-10-28 の実測（4495 本）: OPcache なし 464.50 MB・4 分 07 秒 ／ あり 163.50 MB・2 分 56 秒。
             ⚠ OPcache は php を起動するときに渡す（php -d opcache.enable_cli=1）。この <php> の <ini> や
             phpunit -d は実行中の ini_set なので効かない（実測）。流し方は CLAUDE.md の「テストの流し方」。
             1G は OPcache なしで流したときの余裕として残す。 -->
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_URL" value="http://localhost"/>
        <!-- 本番は APP_LOCALE=ja / APP_FALLBACK_LOCALE=ja。config/app.php の既定は 'en' なので
             ここで指定しないとテストだけ英語になり、日本語メッセージの欠落を検出できない -->
        <env name="APP_LOCALE" value="ja"/>
        <env name="APP_FALLBACK_LOCALE" value="ja"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
